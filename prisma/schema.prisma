generator client {
  provider        = "prisma-client-js"
  output          = "../node_modules/.prisma/client"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model Role {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?
  permissions Json?
  isActive    Boolean @default(true)
  users       User[]
}

model User {
  id                                              Int                        @id @default(autoincrement())
  name                                            String
  email                                           String                     @unique
  passwordHash                                    String
  resetPasswordToken                              String?                    @unique
  resetPasswordExpires                            DateTime?
  roleId                                          Int
  branchId                                        Int?
  implantId                                       Int?
  ticketPrinterId                                 Int?
  canEditReports                                  Boolean?                   @default(false)
  isActive                                        Boolean                    @default(true)
  PreQuotation_PreQuotation_convertedUserIdToUser PreQuotation[]             @relation("PreQuotation_convertedUserIdToUser")
  preQuotations                                   PreQuotation[]             @relation("PreQuotationUser")
  preQuotationHistories                           PreQuotationStateHistory[]
  quotations                                      Quotation[]
  stateHistories                                  QuotationStateHistory[]
  logs                                            SystemLog[]
  branch                                          Branch?                    @relation(fields: [branchId], references: [id])
  implant                                         Implant?                   @relation(fields: [implantId], references: [id])
  role                                            Role                       @relation(fields: [roleId], references: [id])
  ticketPrinter                                   TicketPrinter?             @relation(fields: [ticketPrinterId], references: [id])
}

model Client {
  id                 Int            @id @default(autoincrement())
  name               String
  document           String         @unique
  contactInfo        String?
  address            String?
  mandatoryVariables Json?
  sellerId           Int?
  isActive           Boolean        @default(true)
  creditDays         Int?           @default(0)
  Seller             Seller?        @relation(fields: [sellerId], references: [id], onUpdate: NoAction)
  preQuotations      PreQuotation[]
  quotations         Quotation[]
}

model Provider {
  id                Int                @id @default(autoincrement())
  code              String?            @unique
  name              String
  contactInfo       String?
  commissionConfig  Json?
  providerTypeId    Int?
  airlineCode       String?            @db.VarChar(10)
  sigla             String?            @db.VarChar(10)
  isActive          Boolean            @default(true)
  comboProducts     ComboProduct[]
  preQuotations     PreQuotation[]
  prestadoras       Prestadora[]
  ProviderType      ProviderType?      @relation(fields: [providerTypeId], references: [id], onUpdate: NoAction)
  quotationProducts QuotationProduct[]
}

model Prestadora {
  id                Int                @id @default(autoincrement())
  name              String
  location          String?
  category          String?
  providerId        Int?
  code              String?            @unique(map: "Hotel_code_key")
  type              String?
  initials          String?
  nogds             String?
  isActive          Boolean            @default(true)
  comboProducts     ComboProduct[]
  provider          Provider?          @relation(fields: [providerId], references: [id], onDelete: Restrict)
  quotationProducts QuotationProduct[]
}

model Branch {
  id                      Int                      @id @default(autoincrement())
  code                    String                   @unique
  name                    String
  logo                    Bytes?
  template                Bytes?
  templateConfig          Json?
  htmlTemplate            String?
  resolutionId            Int?
  invoiceTemplate         Bytes?
  invoiceTemplateConfig   Json?
  invoiceHtmlTemplate     String?
  isActive                Boolean                  @default(true)
  BranchGDSInvoiceAuto    BranchGDSInvoiceAuto[]
  cellCustomizations      CellCustomization[]
  documentResolutions     DocumentResolution[]
  implants                Implant[]
  preQuotations           PreQuotation[]
  quotations              Quotation[]
  QuotationFormat         QuotationFormat[]
  SysConsecutivo          SysConsecutivo[]
  transactionConsecutives TransactionConsecutive[]
  users                   User[]
}

model Implant {
  id                      Int                      @id @default(autoincrement())
  code                    String                   @unique
  name                    String
  branchId                Int?
  logo                    Bytes?
  template                Bytes?
  templateConfig          Json?
  htmlTemplate            String?
  Logo                    Bytes?
  resolutionId            Int?
  invoiceTemplate         Bytes?
  invoiceTemplateConfig   Json?
  invoiceHtmlTemplate     String?
  isActive                Boolean?                 @default(true)
  cellCustomizations      CellCustomization[]
  documentResolutions     DocumentResolution[]
  branch                  Branch?                  @relation(fields: [branchId], references: [id])
  quotations              Quotation[]
  QuotationFormat         QuotationFormat[]
  SysConsecutivo          SysConsecutivo[]
  transactionConsecutives TransactionConsecutive[]
  users                   User[]
}

model Seller {
  id            Int            @id @default(autoincrement())
  code          String?        @unique
  name          String
  email         String?
  isActive      Boolean        @default(true)
  clients       Client[]
  preQuotations PreQuotation[]
  quotations    Quotation[]
}

model TicketPrinter {
  id            Int            @id @default(autoincrement())
  code          String?        @unique
  name          String
  email         String?
  isActive      Boolean?       @default(true)
  preQuotations PreQuotation[]
  quotations    Quotation[]
  users         User[]
}

model Product {
  id                Int                @id @default(autoincrement())
  type              String
  description       String
  basePrice         Float
  cost              Float?             @default(0)
  billingConcept    String?
  serviceType       String?
  code              String?            @unique
  airlineItinerary  String?
  classItinerary    String?
  flightItinerary   String?
  ticketTypeId      Int?
  mandatoryFields   Json?
  taxIds            Json?              @default("[]")
  isActive          Boolean            @default(true)
  comboProducts     ComboProduct[]
  ticketType        TicketType?        @relation(fields: [ticketTypeId], references: [id])
  quotationProducts QuotationProduct[]
}

model Quotation {
  id                          Int                      @id @default(autoincrement())
  internalNumber              String                   @unique
  date                        DateTime                 @default(now())
  clientId                    Int
  currency                    String
  exchangeRate                Float
  branchId                    Int
  implantId                   Int?
  sellerId                    Int?
  ticketPrinterId             Int?
  baseCommissionable          Float
  commissionPercentage        Float
  chargesAndTaxes             Float
  totalAmount                 Float
  userId                      Int?
  state                       String?                  @default("Nuevo") @db.VarChar(25)
  stateDescription            String?
  stateUpdatedAt              DateTime?                @db.Timestamp(6)
  costoTotal                  Float?                   @default(0)
  valorBase                   Float?                   @default(0)
  utilidad                    Float?                   @default(0)
  comisionTotalPercentage     Float?                   @default(0)
  comisionFreelancePercentage Float?                   @default(0)
  comisionFreelanceValue      Float?                   @default(0)
  comisionPropiaPercentage    Float?                   @default(0)
  comisionPropiaValue         Float?                   @default(0)
  comisionUtilidadPercentage  Float?                   @default(0)
  destination                 String?                  @db.VarChar(255)
  startDate                   DateTime?                @db.Timestamp(6)
  endDate                     DateTime?                @db.Timestamp(6)
  passenger                   String?                  @db.VarChar(255)
  paxAdults                   Int?
  paxChildren                 Int?
  reservationCode             String?                  @db.VarChar(255)
  copyFieldsToProducts        Boolean?                 @default(true)
  manualDescription           String?
  attachments                 Attachment[]
  preQuotations               PreQuotation[]           @relation("PreQuotationConverted")
  branch                      Branch                   @relation(fields: [branchId], references: [id])
  client                      Client                   @relation(fields: [clientId], references: [id])
  implant                     Implant?                 @relation(fields: [implantId], references: [id])
  seller                      Seller?                  @relation(fields: [sellerId], references: [id])
  ticketPrinter               TicketPrinter?           @relation(fields: [ticketPrinterId], references: [id])
  user                        User?                    @relation(fields: [userId], references: [id])
  combos                      QuotationCombo[]
  manualServices              QuotationManualService[]
  products                    QuotationProduct[]
  stateHistory                QuotationStateHistory[]
}

model QuotationManualService {
  id           Int       @id @default(autoincrement())
  quotationId  Int
  providerName String?   @db.VarChar(255)
  serviceName  String?   @db.VarChar(255)
  cost         Float?    @default(0)
  salePrice    Float?    @default(0)
  utility      Float?    @default(0)
  createdAt    DateTime? @default(now()) @db.Timestamp(6)
  quotation    Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model QuotationCombo {
  id          Int       @id @default(autoincrement())
  quotationId Int
  comboId     Int
  combo       Combo     @relation(fields: [comboId], references: [id])
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
}

model Attachment {
  id          Int       @id @default(autoincrement())
  quotationId Int
  fileName    String
  fileType    String
  fileSize    Int
  fileContent Bytes
  createdAt   DateTime  @default(now())
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
}

model QuotationProduct {
  id                      Int                         @id @default(autoincrement())
  quotationId             Int
  productId               Int
  quantity                Int
  price                   Float
  cost                    Float?                      @default(0)
  providerId              Int?
  prestadoraId            Int?
  checkInDate             DateTime?
  checkOutDate            DateTime?
  nights                  Int?
  paxAdults               Int?
  paxChildren             Int?
  serviceType             String?
  destination             String?
  reservationCode         String?
  sellerCommission        Float?
  ticketPrinterCommission Float?
  comboId                 Int?
  mainTaxId               Int?
  inNationality           Int?                        @default(1)
  service                 String?
  description             String?
  servicios               String?
  descripcion             String?
  passenger               String?                     @db.VarChar(255)
  prestadora              Prestadora?                 @relation(fields: [prestadoraId], references: [id])
  product                 Product                     @relation(fields: [productId], references: [id], onDelete: Cascade)
  provider                Provider?                   @relation(fields: [providerId], references: [id])
  quotation               Quotation                   @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  passengers              QuotationProductPassenger[]
  payments                QuotationProductPayment[]
  appliedTaxes            QuotationProductTax[]
  variables               QuotationProductVariable[]
}

model QuotationProductPassenger {
  id                 Int              @id @default(autoincrement())
  quotationProductId Int
  name               String
  document           String
  quotationProduct   QuotationProduct @relation(fields: [quotationProductId], references: [id], onDelete: Cascade)

  @@map("QuotationProductPassenger")
}

model ChargeAndTax {
  id          Int                   @id @default(autoincrement())
  name        String
  type        String
  valueType   String
  value       Float
  isEditable  Boolean               @default(true)
  code        String?               @unique
  orden       Int?                  @default(0)
  productIds  Json?                 @default("[]")
  targetTaxId Int?
  isActive    Boolean               @default(true)
  comboTaxes  ComboProductTax[]
  appliedTo   QuotationProductTax[]
}

model QuotationProductTax {
  id                 Int              @id @default(autoincrement())
  quotationProductId Int
  chargeAndTaxId     Int
  valueSnapshot      Float
  valueTypeSnapshot  String
  explicitAmount     Float?
  isMain             Boolean          @default(false)
  chargeAndTax       ChargeAndTax     @relation(fields: [chargeAndTaxId], references: [id])
  quotationProduct   QuotationProduct @relation(fields: [quotationProductId], references: [id], onDelete: Cascade)
}

model SystemLog {
  id          Int      @id @default(autoincrement())
  userId      Int?
  action      String
  module      String
  description String
  metadata    Json?
  createdAt   DateTime @default(now())
  user        User?    @relation(fields: [userId], references: [id])
}

model MasterVariable {
  id               Int                        @id @default(autoincrement())
  code             String                     @unique
  name             String
  isActive         Boolean                    @default(true)
  isForAllClients  Boolean                    @default(false)
  productVariables QuotationProductVariable[]
}

model QuotationProductVariable {
  id                 Int              @id @default(autoincrement())
  quotationProductId Int
  masterVariableId   Int
  value              String
  masterVariable     MasterVariable   @relation(fields: [masterVariableId], references: [id])
  quotationProduct   QuotationProduct @relation(fields: [quotationProductId], references: [id], onDelete: Cascade)
}

model SystemParameter {
  id    Int    @id @default(autoincrement())
  code  String @unique
  name  String
  value String
}

model Combo {
  id              Int              @id @default(autoincrement())
  code            String           @unique
  name            String
  cupos           Int?             @default(0)
  currencyId      Int?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime?        @default(now()) @updatedAt @db.Timestamp(6)
  isActive        Boolean          @default(true)
  currency        Currency?        @relation(fields: [currencyId], references: [id])
  products        ComboProduct[]
  quotationCombos QuotationCombo[]
}

model ComboProduct {
  id            Int               @id @default(autoincrement())
  comboId       Int
  productId     Int
  price         Float
  cost          Float?            @default(0)
  checkInDate   DateTime?
  checkOutDate  DateTime?
  prestadoraId  Int?
  mainTaxId     Int?
  paxAdults     Int?
  paxChildren   Int?
  providerId    Int?
  inNationality Int?              @default(1)
  quantity      Int               @default(1)
  combo         Combo             @relation(fields: [comboId], references: [id], onDelete: Cascade)
  prestadora    Prestadora?       @relation(fields: [prestadoraId], references: [id])
  product       Product           @relation(fields: [productId], references: [id])
  provider      Provider?         @relation(fields: [providerId], references: [id])
  appliedTaxes  ComboProductTax[]
}

model ComboProductTax {
  id             Int          @id @default(autoincrement())
  comboProductId Int
  chargeAndTaxId Int
  amount         Float
  isMain         Boolean      @default(false)
  chargeAndTax   ChargeAndTax @relation(fields: [chargeAndTaxId], references: [id])
  comboProduct   ComboProduct @relation(fields: [comboProductId], references: [id], onDelete: Cascade)
}

model Currency {
  id           Int         @id @default(autoincrement())
  code         String      @unique
  name         String
  exchangeRate Float
  decimals     Int         @default(2)
  isActive     Boolean     @default(true)
  combos       Combo[]
  Countries    Countries[]
}

model CellCustomization {
  id        Int      @id @default(autoincrement())
  code      String   @db.VarChar(50)
  name      String   @db.VarChar(100)
  value     String?  @db.VarChar(10)
  branchId  Int?
  implantId Int?
  branch    Branch?  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  implant   Implant? @relation(fields: [implantId], references: [id], onDelete: Cascade)

  @@unique([branchId, code], map: "CellCustomization_branch_code_key", where: raw("(\"branchId\" IS NOT NULL)"))
  @@unique([implantId, code], map: "CellCustomization_implant_code_key", where: raw("(\"implantId\" IS NOT NULL)"))
}

model Invoices {
  id                   Int       @id @default(autoincrement())
  internalNumber       String    @unique @db.VarChar(255)
  date                 DateTime  @default(now()) @db.Timestamp(6)
  clientId             Int
  currency             String    @db.VarChar(50)
  exchangeRate         Float
  branchId             Int
  implantId            Int?
  sellerId             Int?
  ticketPrinterId      Int?
  baseCommissionable   Float
  commissionPercentage Float
  chargesAndTaxes      Float
  totalAmount          Float
  userId               Int?
  state                String?   @default("NUEVO") @db.VarChar(25)
  fuente               String?   @db.VarChar(50)
  serie                String?   @db.VarChar(50)
  consecutivo          String?   @db.VarChar(50)
  dueDate              DateTime? @db.Timestamp(6)
}

model InvoicesProduct {
  id                      Int                        @id @default(autoincrement())
  invoiceId               Int
  productId               Int
  quantity                Int
  price                   Float
  cost                    Float?                     @default(0)
  providerId              Int?
  prestadoraId            Int?
  checkInDate             DateTime?                  @db.Timestamp(6)
  checkOutDate            DateTime?                  @db.Timestamp(6)
  nights                  Int?
  paxAdults               Int?
  paxChildren             Int?
  serviceType             String?                    @db.VarChar(255)
  destination             String?                    @db.VarChar(255)
  reservationCode         String?                    @db.VarChar(255)
  sellerCommission        Float?
  ticketPrinterCommission Float?
  comboId                 Int?
  mainTaxId               Int?
  inNationality           Int?                       @default(1)
  servicios               String?
  descripcion             String?
  itinerary               String?
  class                   String?                    @db.VarChar(100)
  ticketTypeId            Int?
  airline                 String?                    @db.VarChar(100)
  ticketCode              String?
  itineraries             InvoicesProductItinerary[]
}

model InvoicesProductItinerary {
  id               Int             @id @default(autoincrement())
  invoiceProductId Int
  orden            Int?
  origin           String          @db.VarChar(255)
  destination      String          @db.VarChar(255)
  class            String?         @db.VarChar(255)
  checkInDate      DateTime?       @db.Timestamp(6)
  checkOutDate     DateTime?       @db.Timestamp(6)
  terminal         String?         @db.VarChar(255)
  prestadoraCode   String?         @db.VarChar(255)
  farebasis        String?         @db.VarChar(255)
  Numflight        String?         @db.VarChar(25)
  Typeflight       String?         @db.VarChar(1)
  amount           Float?
  co2              Float?
  InvoicesProduct  InvoicesProduct @relation(fields: [invoiceProductId], references: [id], onDelete: Cascade)
}

model InvoicesProductCombo {
  id        Int @id @default(autoincrement())
  invoiceId Int
  comboId   Int
}

model InvoicesProductTax {
  id                Int      @id @default(autoincrement())
  invoiceProductId  Int
  chargeAndTaxId    Int
  valueSnapshot     Float
  valueTypeSnapshot String   @db.VarChar(50)
  explicitAmount    Float?
  isMain            Boolean? @default(false)
}

model InvoicesProductPasenger {
  id               Int    @id @default(autoincrement())
  invoiceProductId Int
  name             String @db.VarChar(255)
  document         String @db.VarChar(255)
}

model InvoicesProductVariable {
  id               Int    @id @default(autoincrement())
  invoiceProductId Int
  masterVariableId Int
  value            String @db.VarChar(255)
}

model InvoicesProductPayment {
  id                Int         @id @default(autoincrement())
  invoiceProductId  Int
  amount            Float
  paymentMethod     String?     @db.VarChar(100)
  date              DateTime?   @default(now()) @db.Timestamp(6)
  reference         String?     @db.VarChar(255)
  authorizationCode String?
  cardNumber        String?
  creditCardId      Int?
  expirationDate    String?
  voucher           String?
  CreditCard        CreditCard? @relation(fields: [creditCardId], references: [id])
}

model TicketType {
  id          Int       @id @default(autoincrement())
  code        String    @unique @db.VarChar(50)
  name        String    @db.VarChar(255)
  description String?
  isActive    Boolean?  @default(true)
  products    Product[]
}

model Airports {
  id       Int     @id @default(autoincrement())
  code     String  @unique @db.VarChar(10)
  name     String  @db.VarChar(150)
  citiesId Int
  isActive Boolean @default(true)
  Cities   Cities  @relation(fields: [citiesId], references: [id], onDelete: Cascade)
}

model BookingGDS {
  id                Int                 @id @default(autoincrement())
  code              String              @unique @db.VarChar(25)
  type              String              @db.VarChar(25)
  blanch            String              @db.VarChar(25)
  implant           String?             @db.VarChar(25)
  external          Boolean             @default(false)
  gds               Int?
  date              DateTime?           @default(now()) @db.Timestamp(6)
  currency          String
  exchangeRate      Float
  tiquetPrinter     String              @db.VarChar(25)
  seller            String              @db.VarChar(25)
  client            String              @db.VarChar(25)
  booking           String?
  typetransaction   String?             @db.VarChar(25)
  iata              String?             @db.VarChar(25)
  description       String?
  observation       String?
  state             String?             @db.VarChar(25)
  BookingProductGDS BookingProductGDS[]
}

model BookingGDSInvoiceAutoLog {
  Id          Int       @id @default(autoincrement())
  branchId    Int?
  implanteId  Int?
  date        DateTime? @db.Timestamp(6)
  menssage    String?
  bookingCode String?   @db.VarChar(25)
  bookingId   Int?
  error       Boolean?
  file        String?
  userId      Int?
}

model BookingProductFEEGDS {
  id                       Int                        @id @default(autoincrement())
  bookingProductId         Int
  code                     String
  name                     String
  type                     String
  description              String
  billigconcept            String
  servicetype              String
  amount                   Float
  tax                      Float
  other                    Float
  total                    Float
  BookingProductGDS        BookingProductGDS          @relation(fields: [bookingProductId], references: [id], onDelete: Cascade)
  BookingProductPaymentGDS BookingProductPaymentGDS[]
}

model BookingProductGDS {
  id                         Int                          @id @default(autoincrement())
  bookingId                  Int
  code                       String                       @db.VarChar(25)
  type                       String?                      @db.VarChar(25)
  service                    String?
  description                String?
  prestadoracode             String?                      @db.VarChar(25)
  prestadorainitials         String?                      @db.VarChar(25)
  prestadoradist             String?                      @db.VarChar(25)
  provider                   String?                      @db.VarChar(25)
  quantity                   Int
  price                      Float
  cost                       Float?                       @default(0)
  checkInDate                DateTime?
  checkOutDate               DateTime?
  nights                     Int?
  paxAdults                  Int?
  paxChildren                Int?
  serviceType                String?
  billingConcept             String?
  destination                String?
  reservationCode            String?
  sellerCom                  Float?
  ticketPrinterCom           Float?
  inNationality              Int?                         @default(1)
  state                      String?                      @default("NUEVO") @db.VarChar(25)
  conjunction                Int?                         @default(0)
  revised                    String?                      @db.VarChar(25)
  typeproduct                String?                      @db.VarChar(25)
  consecutive                String?                      @db.VarChar(25)
  penalty                    String?                      @db.VarChar(25)
  invoiceId                  Int?
  BookingProductFEEGDS       BookingProductFEEGDS[]
  BookingGDS                 BookingGDS                   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  BookingProductItineraryGDS BookingProductItineraryGDS[]
  BookingProductPassangerGDS BookingProductPassangerGDS[]
  BookingProductPaymentGDS   BookingProductPaymentGDS[]
  BookingProductTaxGDS       BookingProductTaxGDS[]
  BookingProductVariableGDS  BookingProductVariableGDS[]
}

model BookingProductItineraryGDS {
  id                Int               @id @default(autoincrement())
  bookingProductId  Int
  orden             Int?
  origin            String
  destination       String
  class             String
  checkInDate       DateTime?
  checkOutDate      DateTime?
  terminal          String
  prestadoraCode    String
  farebasis         String
  Numflight         String?           @db.VarChar(25)
  Typeflight        String?           @db.VarChar(1)
  amount            Float
  BookingProductGDS BookingProductGDS @relation(fields: [bookingProductId], references: [id], onDelete: Cascade)
}

model BookingProductPassangerGDS {
  id                Int               @id @default(autoincrement())
  bookingProductId  Int
  code              String?           @db.VarChar(25)
  firstnm           String?           @db.VarChar(30)
  lastnm            String?           @db.VarChar(30)
  prefix            String?           @db.VarChar(25)
  identification    String?           @db.VarChar(25)
  phone             String?           @db.VarChar(25)
  email             String?           @db.VarChar(250)
  BookingProductGDS BookingProductGDS @relation(fields: [bookingProductId], references: [id], onDelete: Cascade)
}

model BookingProductPaymentGDS {
  id                   Int                   @id @default(autoincrement())
  bookingProductId     Int?
  bookingProductFEEId  Int?
  code                 String                @db.VarChar(50)
  name                 String                @db.VarChar(50)
  type                 String                @db.VarChar(50)
  typecreditcard       String?               @db.VarChar(25)
  numbercreditcard     String?               @db.VarChar(50)
  vouchercreditcard    String?               @db.VarChar(25)
  expiredcreditcard    String?               @db.VarChar(5)
  authcreditcard       String?               @db.VarChar(25)
  quotas               Int?
  bank                 String?               @db.VarChar(25)
  square               String?               @db.VarChar(30)
  reference            String?               @db.VarChar(50)
  policy               String?               @db.VarChar(25)
  policyannex          String?               @db.VarChar(25)
  amount               Float
